msgstr "https://plugins.symonov.com/validation-muse-for-cf7/"

#. Description of the plugin
#: validation-muse-for-contact-form-7.php
msgid "Customize validation messages for each Contact Form 7 field."
msgstr "Настройте сообщения валидации для каждого поля Contact Form 7."

#. Author of the plugin
#: validation-muse-for-contact-form-7.php
msgid "simmotorlp"
msgstr "simmotorlp"

#. Author URI of the plugin
#: validation-muse-for-contact-form-7.php
msgid "https://github.com/symonovserhii"
msgstr "https://github.com/symonovserhii"

#: admin/views/panel.php:33
msgid "Message when the format is wrong"
msgstr "Сообщение при неверном формате"

#: admin/views/panel.php:34
msgid "Shown when the visitor types something that does not fit this kind of field, for example an email address without @. Leave empty to keep the standard message."
msgstr "Показывается, когда посетитель вводит то, что не подходит для этого типа поля, например адрес email без @. Оставьте пустым, чтобы использовать стандартное сообщение."

#: admin/views/panel.php:35 admin/views/panel.php:75
msgid "If the format is wrong"
msgstr "Если формат неверный"

#: admin/views/panel.php:38
msgid "Message when the answer is wrong"
msgstr "Сообщение при неверном ответе"

#: admin/views/panel.php:39
msgid "Shown when the visitor gives the wrong answer to the quiz question. Leave empty to keep the standard message."
msgstr "Показывается, когда посетитель неверно отвечает на контрольный вопрос. Оставьте пустым, чтобы использовать стандартное сообщение."

#: admin/views/panel.php:40
msgid "If the answer is wrong"
msgstr "Если ответ неверный"

#: admin/views/panel.php:43
msgid "Message when the file is too big or the wrong type"
msgstr "Сообщение, если файл слишком большой или неподходящего типа"

#: admin/views/panel.php:44
msgid "Shown when the visitor picks a file that is larger than allowed or of a type you do not accept. Leave empty to keep the standard message."
msgstr "Показывается, когда посетитель выбирает файл больше допустимого размера или типа, который вы не принимаете. Оставьте пустым, чтобы использовать стандартное сообщение."

#: admin/views/panel.php:45
msgid "If the file is too big or the wrong type"
msgstr "Если файл слишком большой или неподходящего типа"

#: admin/views/panel.php:55
msgid "Text"
msgstr "Текст"

#: admin/views/panel.php:56
msgid "Email"
msgstr "Email"

#: admin/views/panel.php:57
msgid "Web address"
msgstr "Веб-адрес"

#: admin/views/panel.php:58
msgid "Phone"
msgstr "Телефон"

#: admin/views/panel.php:59
msgid "Number"
msgstr "Число"

#: admin/views/panel.php:60
msgid "Slider"
msgstr "Ползунок"

#: admin/views/panel.php:61
msgid "Date"
msgstr "Дата"

#: admin/views/panel.php:62
msgid "Time"
msgstr "Время"

#: admin/views/panel.php:63
msgid "Long text"
msgstr "Длинный текст"

#: admin/views/panel.php:64
msgid "Drop-down"
msgstr "Выпадающий список"

#: admin/views/panel.php:65
msgid "Checkboxes"
msgstr "Флажки"

#: admin/views/panel.php:66
msgid "Radio buttons"
msgstr "Переключатели"

#: admin/views/panel.php:67
msgid "File upload"
msgstr "Загрузка файла"

#: admin/views/panel.php:68
msgid "Acceptance"
msgstr "Согласие"

#: admin/views/panel.php:69
msgid "Quiz"
msgstr "Контрольный вопрос"

#: admin/views/panel.php:74
msgid "If left empty"
msgstr "Если не заполнено"

#: admin/views/panel.php:76
msgid "If too short or too long"
msgstr "Если слишком коротко или длинно"

#: admin/views/panel.php:77
msgid "If the pattern does not match"
msgstr "Если не соответствует шаблону"

#: admin/views/panel.php:78
msgid "If empty while the other field is filled in"
msgstr "Если пусто, а другое поле заполнено"

#: admin/views/panel.php:95
msgid "Digits only"
msgstr "Только цифры"

#: admin/views/panel.php:96
msgid "Exactly 5 digits (e.g. a ZIP code)"
msgstr "Ровно 5 цифр (например, почтовый индекс)"

#: admin/views/panel.php:97
msgid "Letters only (names)"
msgstr "Только буквы (имена)"

#: admin/views/panel.php:98
msgid "Letters, digits, dash and underscore"
msgstr "Буквы, цифры, дефис и подчёркивание"

#: admin/views/panel.php:99
msgid "Phone number"
msgstr "Номер телефона"

#: admin/views/panel.php:100
msgid "No links allowed"
msgstr "Ссылки запрещены"

#: admin/views/panel.php:129 admin/views/panel.php:314
msgid "Customized"
msgstr "Настроено"

#: admin/views/panel.php:130 admin/views/panel.php:314
msgid "Default messages"
msgstr "Стандартные сообщения"

#. translators: 1: number of customized fields, 2: total number of fields.
#: admin/views/panel.php:132 admin/views/panel.php:244
#, php-format
msgid "%1$s of %2$s fields customized"
msgstr "Настроено полей: %1$s из %2$s"

#: admin/views/panel.php:133
msgid "Contact Form 7’s standard message"
msgstr "Стандартное сообщение Contact Form 7"

#: admin/views/panel.php:134 includes/class-vmcf7-loader.php:180
msgid "This field is required"
msgstr "Это поле обязательно для заполнения"

#: admin/views/panel.php:135 includes/class-vmcf7-loader.php:204
msgid "Invalid format."
msgstr "Неверный формат."

#: admin/views/panel.php:136 includes/class-vmcf7-loader.php:214
#: includes/class-vmcf7-loader.php:878
msgid "Invalid length."
msgstr "Неверная длина."

#. translators: %d: number of characters.
#: admin/views/panel.php:138
#, php-format
msgid "This message is very long (%d characters). Short messages are easier to read."
msgstr "Это сообщение очень длинное (символов: %d). Короткие сообщения читать легче."

#. translators: %s: list of HTML tags.
#: admin/views/panel.php:140
#, php-format
msgid "These HTML tags are not allowed and will be removed when you save: %s"
msgstr "Эти HTML-теги не разрешены и будут удалены при сохранении: %s"

#: admin/views/panel.php:141
msgid "This field has no length limit yet (Extra rules → Length limit), so {min} and {max} will be left blank."
msgstr "У этого поля пока нет ограничения длины (Дополнительные правила → Ограничение длины), поэтому на месте {min} и {max} будет пусто."

#: admin/views/panel.php:142
msgid "The minimum is larger than the maximum, so no value can ever pass."
msgstr "Минимум больше максимума, поэтому ни одно значение не пройдёт проверку."

#: admin/views/panel.php:143
msgid "This pattern may be invalid. Please test it on the live form before relying on it."
msgstr "Возможно, этот шаблон некорректен. Проверьте его на работающей форме, прежде чем на него полагаться."

#: admin/views/panel.php:144
msgid "Accepted — no error would be shown."
msgstr "Принято — ошибка показана не будет."

#: admin/views/panel.php:145
msgid "Rejected — the visitor would see the error message."
msgstr "Отклонено — посетитель увидит сообщение об ошибке."

#: admin/views/panel.php:146
msgid "This pattern cannot be tested here."
msgstr "Этот шаблон нельзя проверить здесь."

#: admin/views/panel.php:147
msgid "Working…"
msgstr "Выполняется…"

#: admin/views/panel.php:148
msgid "Cancel"
msgstr "Отмена"

#: admin/views/panel.php:149
msgid "Reloading the page…"
msgstr "Страница перезагружается…"

#: admin/views/panel.php:150
msgid "Something went wrong. Please try again."
msgstr "Что-то пошло не так. Попробуйте ещё раз."

#: admin/views/panel.php:151
msgid "Network error. Please check your internet connection and try again."
msgstr "Ошибка сети. Проверьте подключение к интернету и попробуйте ещё раз."

#: admin/views/panel.php:152
msgid "Please choose a form to copy from first."
msgstr "Сначала выберите форму, из которой нужно скопировать."

#. translators: %s: form title.
#: admin/views/panel.php:154
#, php-format
msgid "Replace all validation settings of this form with the ones from “%s”? Everything set up here, including unsaved changes, will be overwritten."
msgstr "Заменить все настройки валидации этой формы настройками из «%s»? Всё, что настроено здесь, включая несохранённые изменения, будет перезаписано."

#: admin/views/panel.php:155
msgid "Yes, copy and replace"
msgstr "Да, скопировать и заменить"

#. translators: %s: file name.
#: admin/views/panel.php:157
#, php-format
msgid "Replace all validation settings of this form with the contents of “%s”? Everything set up here, including unsaved changes, will be overwritten."
msgstr "Заменить все настройки валидации этой формы содержимым файла «%s»? Всё, что настроено здесь, включая несохранённые изменения, будет перезаписано."

#: admin/views/panel.php:158
msgid "Yes, load the file"
msgstr "Да, загрузить файл"

#: admin/views/panel.php:159
msgid "Please choose a .json file that was downloaded from this plugin."
msgstr "Выберите файл .json, скачанный из этого плагина."

#: admin/views/panel.php:160
msgid "Replace all validation settings of this form with your saved template? Everything set up here, including unsaved changes, will be overwritten."
msgstr "Заменить все настройки валидации этой формы вашим сохранённым шаблоном? Всё, что настроено здесь, включая несохранённые изменения, будет перезаписано."

#: admin/views/panel.php:161
msgid "Yes, use the template"
msgstr "Да, использовать шаблон"

#: admin/views/panel.php:162
msgid "Save this form’s settings as your template? A template you saved earlier will be replaced."
msgstr "Сохранить настройки этой формы как ваш шаблон? Ранее сохранённый шаблон будет заменён."

#: admin/views/panel.php:163
msgid "Yes, save as template"
msgstr "Да, сохранить как шаблон"

#. translators: %d: number of other contact forms.
#: admin/views/panel.php:166
#, php-format
msgid "Overwrite the validation settings of your %d other contact form with the saved settings of this form? This cannot be undone."
msgid_plural "Overwrite the validation settings of all %d other contact forms with the saved settings of this form? This cannot be undone."
msgstr[0] "Перезаписать настройки валидации %d другой контактной формы сохранёнными настройками этой формы? Это действие нельзя отменить."
msgstr[1] "Перезаписать настройки валидации всех %d других контактных форм сохранёнными настройками этой формы? Это действие нельзя отменить."
msgstr[2] "Перезаписать настройки валидации всех %d других контактных форм сохранёнными настройками этой формы? Это действие нельзя отменить."

#: admin/views/panel.php:174
msgid "Yes, overwrite all other forms"
msgstr "Да, перезаписать все остальные формы"

#: admin/views/panel.php:175
msgid "Translating…"
msgstr "Перевод…"

#: admin/views/panel.php:176
msgid "Translation failed. Please try again."
msgstr "Не удалось выполнить перевод. Попробуйте ещё раз."

#. translators: %d: number of translated messages.
#: admin/views/panel.php:178
#, php-format
msgid "%d messages translated. Check them, then save the form to keep them."
msgstr "Переведено сообщений: %d. Проверьте их и сохраните форму, чтобы они не потерялись."

#: admin/views/panel.php:187 includes/class-vmcf7-admin.php:93
msgid "Custom Validation"
msgstr "Пользовательская валидация"

#: admin/views/panel.php:189
msgid "Choose what visitors read when they fill in a field incorrectly, and add extra checks such as a minimum length. Fields you leave untouched keep Contact Form 7’s standard messages."
msgstr "Выберите, что увидят посетители, если заполнят поле неправильно, и добавьте дополнительные проверки, например минимальную длину. Для полей, которые вы не трогали, остаются стандартные сообщения Contact Form 7."

#: admin/views/panel.php:203
msgid "Use custom validation on this form"
msgstr "Использовать пользовательскую валидацию в этой форме"

#: admin/views/panel.php:206
msgid "On — the messages and rules below are used on your site."
msgstr "Включено — сообщения и правила ниже используются на вашем сайте."

#: admin/views/panel.php:207
msgid "Off — visitors see Contact Form 7’s standard messages. Your settings below are kept, so you can switch this back on at any time."
msgstr "Выключено — посетители видят стандартные сообщения Contact Form 7. Ваши настройки ниже сохраняются, так что вы можете включить это снова в любой момент."

#: admin/views/panel.php:215
msgid "This form has no fields yet"
msgstr "В этой форме пока нет полей"

#: admin/views/panel.php:216
msgid "Add fields on the “Form” tab and save the form. They will then appear here, ready for your own messages and rules."
msgstr "Добавьте поля на вкладке «Шаблон формы» и сохраните форму. После этого они появятся здесь, и вы сможете задать для них свои сообщения и правила."

#: admin/views/panel.php:224
msgid "Find a field"
msgstr "Найти поле"

#: admin/views/panel.php:228
msgid "Find a field…"
msgstr "Найти поле…"

#: admin/views/panel.php:234
msgid "Only show customized fields"
msgstr "Показывать только настроенные поля"

#: admin/views/panel.php:252
msgid "Open all"
msgstr "Развернуть все"

#: admin/views/panel.php:253
msgid "Close all"
msgstr "Свернуть все"

#: admin/views/panel.php:309
msgid "Required"
msgstr "Обязательное"

#: admin/views/panel.php:311
msgid "Optional"
msgstr "Необязательное"

#: admin/views/panel.php:323
msgid "Message when the field is left empty"
msgstr "Сообщение, если поле не заполнено"

#: admin/views/panel.php:331
msgid "e.g. Please fill in {field_label}"
msgstr "например: Пожалуйста, заполните поле {field_label}"

#: admin/views/panel.php:334
msgid "Shown when a visitor skips this required field. Leave empty to keep the standard message."
msgstr "Показывается, когда посетитель пропускает это обязательное поле. Оставьте пустым, чтобы использовать стандартное сообщение."

#: admin/views/panel.php:336
msgid "This field is optional in your form, so this message is not shown yet. To make the field required, add * after its type on the “Form” tab (for example [text* your-name])."
msgstr "Это поле в вашей форме необязательное, поэтому сообщение пока не показывается. Чтобы сделать поле обязательным, добавьте * после его типа на вкладке «Шаблон формы» (например, [text* your-name])."

#. translators: %s: example message.
#: admin/views/panel.php:353
#, php-format
msgid "e.g. %s"
msgstr "например: %s"

#: admin/views/panel.php:368
msgid "Extra rules"
msgstr "Дополнительные правила"

#: admin/views/panel.php:369
msgid "length limit, allowed characters, required only sometimes"
msgstr "ограничение длины, допустимые символы, обязательность по условию"

#: admin/views/panel.php:369
msgid "required only sometimes"
msgstr "обязательность по условию"

#: admin/views/panel.php:377
msgid "Length limit"
msgstr "Ограничение длины"

#: admin/views/panel.php:378
msgid "How many characters the answer may have. Fill in one or both; leave empty for no limit."
msgstr "Сколько символов может быть в ответе. Заполните одно или оба значения; оставьте пустыми, чтобы не ограничивать."

#: admin/views/panel.php:381
msgid "At least"
msgstr "Не менее"

#: admin/views/panel.php:391
msgid "At most"
msgstr "Не более"

#: admin/views/panel.php:400
msgid "characters"
msgstr "символов"

#: admin/views/panel.php:404
msgid "Message when the answer is too short or too long"
msgstr "Сообщение, если ответ слишком короткий или слишком длинный"

#: admin/views/panel.php:411
msgid "e.g. Please use between {min} and {max} characters"
msgstr "например: Пожалуйста, введите от {min} до {max} символов"

#: admin/views/panel.php:418
msgid "Allowed characters (pattern)"
msgstr "Допустимые символы (шаблон)"

#: admin/views/panel.php:419
msgid "Advanced"
msgstr "Дополнительно"

#: admin/views/panel.php:421
msgid "Only accept answers that match a pattern (a “regular expression”). Not sure how to write one? Pick a ready-made example."
msgstr "Принимать только ответы, соответствующие шаблону («регулярному выражению»). Не знаете, как его написать? Выберите готовый пример."

#: admin/views/panel.php:423
msgid "Ready-made examples"
msgstr "Готовые примеры"

#: admin/views/panel.php:425
msgid "— Choose an example —"
msgstr "— Выберите пример —"

#: admin/views/panel.php:431
msgid "Pattern"
msgstr "Шаблон"

#: admin/views/panel.php:441
msgid "Write it without the surrounding slashes. Important: the pattern only has to be found somewhere in the answer, so [0-9]+ also accepts “abc1”. To check the whole answer, start with ^ and end with $, like ^[0-9]+$. Leave empty for no pattern check."
msgstr "Пишите его без косых черт по краям. Важно: достаточно, чтобы шаблон нашёлся где-нибудь в ответе, поэтому [0-9]+ примет и «abc1». Чтобы проверять ответ целиком, начните с ^ и закончите $, например ^[0-9]+$. Оставьте пустым, чтобы не проверять по шаблону."

#: admin/views/panel.php:443
msgid "The saved pattern is not valid, so it is currently ignored on your site. Correct it or clear it."
msgstr "Сохранённый шаблон некорректен, поэтому сейчас он на вашем сайте не учитывается. Исправьте его или очистите."

#: admin/views/panel.php:448
msgid "Try it: type an example answer"
msgstr "Проверьте: введите пример ответа"

#: admin/views/panel.php:456
msgid "Message when the answer does not match"
msgstr "Сообщение, если ответ не соответствует шаблону"

#: admin/views/panel.php:463
msgid "e.g. Please use digits only"
msgstr "например: Пожалуйста, используйте только цифры"

#: admin/views/panel.php:471
msgid "Required only sometimes"
msgstr "Обязательное по условию"

#: admin/views/panel.php:472
msgid "Make this field required only when the visitor has filled in (or ticked) another field. Example: ask for a phone number only if “Call me back” is ticked."
msgstr "Сделайте это поле обязательным, только если посетитель заполнил (или отметил) другое поле. Пример: просить номер телефона, только если отмечено «Перезвоните мне»."

#: admin/views/panel.php:474
msgid "Required when this field is filled in"
msgstr "Обязательное, если заполнено это поле"

#: admin/views/panel.php:479
msgid "— Not used —"
msgstr "— Не используется —"

#. translators: %s: field name.
#: admin/views/panel.php:498
#, php-format
msgid "%s (not found in this form)"
msgstr "%s (не найдено в этой форме)"

#: admin/views/panel.php:504
msgid "Message when it is then left empty"
msgstr "Сообщение, если поле при этом не заполнено"

#: admin/views/panel.php:511
msgid "e.g. Please add your phone number so we can call you back"
msgstr "например: Пожалуйста, укажите номер телефона, чтобы мы могли вам перезвонить"

#: admin/views/panel.php:519
msgid "Clear all settings of this field"
msgstr "Сбросить все настройки этого поля"

#: admin/views/panel.php:526
msgid "What visitors will see"
msgstr "Что увидят посетители"

#: admin/views/panel.php:545
msgid "Smart words"
msgstr "Умные слова"

#: admin/views/panel.php:546
msgid "Click one to add it to the message you are writing. It is replaced automatically on your site."
msgstr "Нажмите на слово, чтобы добавить его в сообщение, которое вы пишете. На сайте оно заменяется автоматически."

#: admin/views/panel.php:550
msgid "the field’s label, e.g. “Your email”"
msgstr "подпись поля, например «Ваш email»"

#: admin/views/panel.php:554
msgid "the “at least” number from Length limit"
msgstr "число «Не менее» из ограничения длины"

#: admin/views/panel.php:558
msgid "the “at most” number from Length limit"
msgstr "число «Не более» из ограничения длины"

#: admin/views/panel.php:567
msgid "No fields match. Clear the search or untick “Only show customized fields”."
msgstr "Подходящих полей нет. Очистите поиск или снимите отметку «Показывать только настроенные поля»."

#: admin/views/panel.php:572
msgid "Changes take effect after you save the form. Added a new field on the “Form” tab? Save the form and it will show up here."
msgstr "Изменения вступают в силу после сохранения формы. Добавили новое поле на вкладке «Шаблон формы»? Сохраните форму, и оно появится здесь."

#: admin/views/panel.php:580 admin/views/panel.php:609
msgid "Translations"
msgstr "Переводы"

#: admin/views/panel.php:582
msgid "Your messages are registered for translation each time you save the form. Save first, then translate them here:"
msgstr "Ваши сообщения регистрируются для перевода при каждом сохранении формы. Сначала сохраните форму, затем переведите их здесь:"

#: admin/views/panel.php:587

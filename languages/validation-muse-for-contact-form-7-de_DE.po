msgstr "Telefonnummer"

#: admin/views/panel.php:100
msgid "No links allowed"
msgstr "Keine Links erlaubt"

#: admin/views/panel.php:129 admin/views/panel.php:314
msgid "Customized"
msgstr "Angepasst"

#: admin/views/panel.php:130 admin/views/panel.php:314
msgid "Default messages"
msgstr "Standardmeldungen"

#. translators: 1: number of customized fields, 2: total number of fields.
#: admin/views/panel.php:132 admin/views/panel.php:244
#, php-format
msgid "%1$s of %2$s fields customized"
msgstr "%1$s von %2$s Feldern angepasst"

#: admin/views/panel.php:133
msgid "Contact Form 7’s standard message"
msgstr "Standardmeldung von Contact Form 7"

#: admin/views/panel.php:134 includes/class-vmcf7-loader.php:180
msgid "This field is required"
msgstr "Dieses Feld ist erforderlich"

#: admin/views/panel.php:135 includes/class-vmcf7-loader.php:204
msgid "Invalid format."
msgstr "Ungültiges Format."

#: admin/views/panel.php:136 includes/class-vmcf7-loader.php:214
#: includes/class-vmcf7-loader.php:878
msgid "Invalid length."
msgstr "Ungültige Länge."

#. translators: %d: number of characters.
#: admin/views/panel.php:138
#, php-format
msgid "This message is very long (%d characters). Short messages are easier to read."
msgstr "Diese Meldung ist sehr lang (%d Zeichen). Kurze Meldungen sind leichter zu lesen."

#. translators: %s: list of HTML tags.
#: admin/views/panel.php:140
#, php-format
msgid "These HTML tags are not allowed and will be removed when you save: %s"
msgstr "Diese HTML-Tags sind nicht erlaubt und werden beim Speichern entfernt: %s"

#: admin/views/panel.php:141
msgid "This field has no length limit yet (Extra rules → Length limit), so {min} and {max} will be left blank."
msgstr "Dieses Feld hat noch keine Längenbegrenzung (Zusätzliche Regeln → Längenbegrenzung), daher bleiben {min} und {max} leer."

#: admin/views/panel.php:142
msgid "The minimum is larger than the maximum, so no value can ever pass."
msgstr "Das Minimum ist größer als das Maximum, daher kann kein Wert jemals gültig sein."

#: admin/views/panel.php:143
msgid "This pattern may be invalid. Please test it on the live form before relying on it."
msgstr "Dieses Muster ist möglicherweise ungültig. Bitte teste es im echten Formular, bevor du dich darauf verlässt."

#: admin/views/panel.php:144
msgid "Accepted — no error would be shown."
msgstr "Akzeptiert – es würde kein Fehler angezeigt."

#: admin/views/panel.php:145
msgid "Rejected — the visitor would see the error message."
msgstr "Abgelehnt – der Besucher würde die Fehlermeldung sehen."

#: admin/views/panel.php:146
msgid "This pattern cannot be tested here."
msgstr "Dieses Muster kann hier nicht getestet werden."

#: admin/views/panel.php:147
msgid "Working…"
msgstr "Wird ausgeführt …"

#: admin/views/panel.php:148
msgid "Cancel"
msgstr "Abbrechen"

#: admin/views/panel.php:149
msgid "Reloading the page…"
msgstr "Seite wird neu geladen …"

#: admin/views/panel.php:150
msgid "Something went wrong. Please try again."
msgstr "Etwas ist schiefgelaufen. Bitte versuche es erneut."

#: admin/views/panel.php:151
msgid "Network error. Please check your internet connection and try again."
msgstr "Netzwerkfehler. Bitte überprüfe deine Internetverbindung und versuche es erneut."

#: admin/views/panel.php:152
msgid "Please choose a form to copy from first."
msgstr "Bitte wähle zuerst ein Formular aus, von dem kopiert werden soll."

#. translators: %s: form title.
#: admin/views/panel.php:154
#, php-format
msgid "Replace all validation settings of this form with the ones from “%s”? Everything set up here, including unsaved changes, will be overwritten."
msgstr "Alle Validierungseinstellungen dieses Formulars durch die von „%s“ ersetzen? Alles, was hier eingerichtet ist, einschließlich nicht gespeicherter Änderungen, wird überschrieben."

#: admin/views/panel.php:155
msgid "Yes, copy and replace"
msgstr "Ja, kopieren und ersetzen"

#. translators: %s: file name.
#: admin/views/panel.php:157
#, php-format
msgid "Replace all validation settings of this form with the contents of “%s”? Everything set up here, including unsaved changes, will be overwritten."
msgstr "Alle Validierungseinstellungen dieses Formulars durch den Inhalt von „%s“ ersetzen? Alles, was hier eingerichtet ist, einschließlich nicht gespeicherter Änderungen, wird überschrieben."

#: admin/views/panel.php:158
msgid "Yes, load the file"
msgstr "Ja, Datei laden"

#: admin/views/panel.php:159
msgid "Please choose a .json file that was downloaded from this plugin."
msgstr "Bitte wähle eine .json-Datei aus, die mit diesem Plugin heruntergeladen wurde."

#: admin/views/panel.php:160
msgid "Replace all validation settings of this form with your saved template? Everything set up here, including unsaved changes, will be overwritten."
msgstr "Alle Validierungseinstellungen dieses Formulars durch deine gespeicherte Vorlage ersetzen? Alles, was hier eingerichtet ist, einschließlich nicht gespeicherter Änderungen, wird überschrieben."

#: admin/views/panel.php:161
msgid "Yes, use the template"
msgstr "Ja, Vorlage verwenden"

#: admin/views/panel.php:162
msgid "Save this form’s settings as your template? A template you saved earlier will be replaced."
msgstr "Die Einstellungen dieses Formulars als deine Vorlage speichern? Eine früher gespeicherte Vorlage wird ersetzt."

#: admin/views/panel.php:163
msgid "Yes, save as template"
msgstr "Ja, als Vorlage speichern"

#. translators: %d: number of other contact forms.
#: admin/views/panel.php:166
#, php-format
msgid "Overwrite the validation settings of your %d other contact form with the saved settings of this form? This cannot be undone."
msgid_plural "Overwrite the validation settings of all %d other contact forms with the saved settings of this form? This cannot be undone."
msgstr[0] "Die Validierungseinstellungen deines %d anderen Kontaktformulars mit den gespeicherten Einstellungen dieses Formulars überschreiben? Das kann nicht rückgängig gemacht werden."
msgstr[1] "Die Validierungseinstellungen aller %d anderen Kontaktformulare mit den gespeicherten Einstellungen dieses Formulars überschreiben? Das kann nicht rückgängig gemacht werden."

#: admin/views/panel.php:174
msgid "Yes, overwrite all other forms"
msgstr "Ja, alle anderen Formulare überschreiben"

#: admin/views/panel.php:175
msgid "Translating…"
msgstr "Wird übersetzt …"

#: admin/views/panel.php:176
msgid "Translation failed. Please try again."
msgstr "Übersetzung fehlgeschlagen. Bitte versuche es erneut."

#. translators: %d: number of translated messages.
#: admin/views/panel.php:178
#, php-format
msgid "%d messages translated. Check them, then save the form to keep them."
msgstr "%d Meldungen übersetzt. Prüfe sie und speichere dann das Formular, um sie zu behalten."

#: admin/views/panel.php:187 includes/class-vmcf7-admin.php:93
msgid "Custom Validation"
msgstr "Benutzerdefinierte Validierung"

#: admin/views/panel.php:189
msgid "Choose what visitors read when they fill in a field incorrectly, and add extra checks such as a minimum length. Fields you leave untouched keep Contact Form 7’s standard messages."
msgstr "Lege fest, was Besucher lesen, wenn sie ein Feld falsch ausfüllen, und füge zusätzliche Prüfungen hinzu, etwa eine Mindestlänge. Felder, die du nicht anfasst, behalten die Standardmeldungen von Contact Form 7."

#: admin/views/panel.php:203
msgid "Use custom validation on this form"
msgstr "Benutzerdefinierte Validierung für dieses Formular verwenden"

#: admin/views/panel.php:206
msgid "On — the messages and rules below are used on your site."
msgstr "An – die Meldungen und Regeln unten werden auf deiner Website verwendet."

#: admin/views/panel.php:207
msgid "Off — visitors see Contact Form 7’s standard messages. Your settings below are kept, so you can switch this back on at any time."
msgstr "Aus – Besucher sehen die Standardmeldungen von Contact Form 7. Deine Einstellungen unten bleiben erhalten, sodass du dies jederzeit wieder einschalten kannst."

#: admin/views/panel.php:215
msgid "This form has no fields yet"
msgstr "Dieses Formular hat noch keine Felder"

#: admin/views/panel.php:216
msgid "Add fields on the “Form” tab and save the form. They will then appear here, ready for your own messages and rules."
msgstr "Füge im Tab „Formular“ Felder hinzu und speichere das Formular. Sie erscheinen dann hier, bereit für deine eigenen Meldungen und Regeln."

#: admin/views/panel.php:224
msgid "Find a field"
msgstr "Feld suchen"

#: admin/views/panel.php:228
msgid "Find a field…"
msgstr "Feld suchen …"

#: admin/views/panel.php:234
msgid "Only show customized fields"
msgstr "Nur angepasste Felder anzeigen"

#: admin/views/panel.php:252
msgid "Open all"
msgstr "Alle öffnen"

#: admin/views/panel.php:253
msgid "Close all"
msgstr "Alle schließen"

#: admin/views/panel.php:309
msgid "Required"
msgstr "Pflichtfeld"

#: admin/views/panel.php:311
msgid "Optional"
msgstr "Optional"

#: admin/views/panel.php:323
msgid "Message when the field is left empty"
msgstr "Meldung, wenn das Feld leer bleibt"

#: admin/views/panel.php:331
msgid "e.g. Please fill in {field_label}"
msgstr "z. B. Bitte fülle {field_label} aus"

#: admin/views/panel.php:334
msgid "Shown when a visitor skips this required field. Leave empty to keep the standard message."
msgstr "Wird angezeigt, wenn ein Besucher dieses Pflichtfeld auslässt. Leer lassen, um die Standardmeldung beizubehalten."

#: admin/views/panel.php:336
msgid "This field is optional in your form, so this message is not shown yet. To make the field required, add * after its type on the “Form” tab (for example [text* your-name])."
msgstr "Dieses Feld ist in deinem Formular optional, daher wird diese Meldung noch nicht angezeigt. Um es zum Pflichtfeld zu machen, füge im Tab „Formular“ ein * nach seinem Typ ein (zum Beispiel [text* your-name])."

#. translators: %s: example message.
#: admin/views/panel.php:353
#, php-format
msgid "e.g. %s"
msgstr "z. B. %s"

#: admin/views/panel.php:368
msgid "Extra rules"
msgstr "Zusätzliche Regeln"

#: admin/views/panel.php:369
msgid "length limit, allowed characters, required only sometimes"
msgstr "Längenbegrenzung, erlaubte Zeichen, nur manchmal erforderlich"

#: admin/views/panel.php:369
msgid "required only sometimes"
msgstr "nur manchmal erforderlich"

#: admin/views/panel.php:377
msgid "Length limit"
msgstr "Längenbegrenzung"

#: admin/views/panel.php:378
msgid "How many characters the answer may have. Fill in one or both; leave empty for no limit."
msgstr "Wie viele Zeichen die Antwort haben darf. Fülle einen oder beide Werte aus; leer lassen für keine Begrenzung."

#: admin/views/panel.php:381
msgid "At least"
msgstr "Mindestens"

#: admin/views/panel.php:391
msgid "At most"
msgstr "Höchstens"

#: admin/views/panel.php:400
msgid "characters"
msgstr "Zeichen"

#: admin/views/panel.php:404
msgid "Message when the answer is too short or too long"
msgstr "Meldung, wenn die Antwort zu kurz oder zu lang ist"

#: admin/views/panel.php:411
msgid "e.g. Please use between {min} and {max} characters"
msgstr "z. B. Bitte verwende zwischen {min} und {max} Zeichen"

#: admin/views/panel.php:418
msgid "Allowed characters (pattern)"
msgstr "Erlaubte Zeichen (Muster)"

#: admin/views/panel.php:419
msgid "Advanced"
msgstr "Erweitert"

#: admin/views/panel.php:421
msgid "Only accept answers that match a pattern (a “regular expression”). Not sure how to write one? Pick a ready-made example."
msgstr "Nur Antworten akzeptieren, die zu einem Muster (einem „regulären Ausdruck“) passen. Du weißt nicht, wie man eines schreibt? Wähle ein fertiges Beispiel."

#: admin/views/panel.php:423
msgid "Ready-made examples"
msgstr "Fertige Beispiele"

#: admin/views/panel.php:425
msgid "— Choose an example —"
msgstr "— Beispiel auswählen —"

#: admin/views/panel.php:431
msgid "Pattern"
msgstr "Muster"

#: admin/views/panel.php:441
msgid "Write it without the surrounding slashes. Important: the pattern only has to be found somewhere in the answer, so [0-9]+ also accepts “abc1”. To check the whole answer, start with ^ and end with $, like ^[0-9]+$. Leave empty for no pattern check."
msgstr "Schreibe es ohne die umgebenden Schrägstriche. Wichtig: Das Muster muss nur irgendwo in der Antwort vorkommen, [0-9]+ akzeptiert also auch „abc1“. Um die gesamte Antwort zu prüfen, beginne mit ^ und ende mit $, etwa ^[0-9]+$. Leer lassen, um kein Muster zu prüfen."

#: admin/views/panel.php:443
msgid "The saved pattern is not valid, so it is currently ignored on your site. Correct it or clear it."
msgstr "Das gespeicherte Muster ist ungültig und wird daher auf deiner Website derzeit ignoriert. Korrigiere oder lösche es."

#: admin/views/panel.php:448
msgid "Try it: type an example answer"
msgstr "Ausprobieren: Gib eine Beispielantwort ein"

#: admin/views/panel.php:456
msgid "Message when the answer does not match"
msgstr "Meldung, wenn die Antwort nicht passt"

#: admin/views/panel.php:463
msgid "e.g. Please use digits only"
msgstr "z. B. Bitte verwende nur Ziffern"

#: admin/views/panel.php:471
msgid "Required only sometimes"
msgstr "Nur manchmal erforderlich"

#: admin/views/panel.php:472
msgid "Make this field required only when the visitor has filled in (or ticked) another field. Example: ask for a phone number only if “Call me back” is ticked."
msgstr "Mache dieses Feld nur dann zum Pflichtfeld, wenn der Besucher ein anderes Feld ausgefüllt (oder angehakt) hat. Beispiel: Frage nur dann nach einer Telefonnummer, wenn „Bitte um Rückruf“ angehakt ist."

#: admin/views/panel.php:474
msgid "Required when this field is filled in"
msgstr "Erforderlich, wenn dieses Feld ausgefüllt ist"

#: admin/views/panel.php:479
msgid "— Not used —"
msgstr "— Nicht verwendet —"

#. translators: %s: field name.
#: admin/views/panel.php:498
#, php-format
msgid "%s (not found in this form)"
msgstr "%s (in diesem Formular nicht gefunden)"

#: admin/views/panel.php:504
msgid "Message when it is then left empty"
msgstr "Meldung, wenn es dann leer bleibt"

#: admin/views/panel.php:511
msgid "e.g. Please add your phone number so we can call you back"
msgstr "z. B. Bitte gib deine Telefonnummer an, damit wir dich zurückrufen können"

#: admin/views/panel.php:519
msgid "Clear all settings of this field"
msgstr "Alle Einstellungen dieses Feldes löschen"

#: admin/views/panel.php:526
msgid "What visitors will see"
msgstr "Was Besucher sehen werden"

#: admin/views/panel.php:545
msgid "Smart words"
msgstr "Platzhalter"

#: admin/views/panel.php:546
msgid "Click one to add it to the message you are writing. It is replaced automatically on your site."
msgstr "Klicke auf einen, um ihn in die Meldung einzufügen, die du gerade schreibst. Auf deiner Website wird er automatisch ersetzt."

#: admin/views/panel.php:550
msgid "the field’s label, e.g. “Your email”"
msgstr "die Beschriftung des Feldes, z. B. „Deine E-Mail-Adresse“"

#: admin/views/panel.php:554
msgid "the “at least” number from Length limit"
msgstr "die „Mindestens“-Zahl aus der Längenbegrenzung"

#: admin/views/panel.php:558
msgid "the “at most” number from Length limit"
msgstr "die „Höchstens“-Zahl aus der Längenbegrenzung"

#: admin/views/panel.php:567
msgid "No fields match. Clear the search or untick “Only show customized fields”."
msgstr "Keine passenden Felder. Leere die Suche oder entferne den Haken bei „Nur angepasste Felder anzeigen“."

#: admin/views/panel.php:572
msgid "Changes take effect after you save the form. Added a new field on the “Form” tab? Save the form and it will show up here."
msgstr "Änderungen werden wirksam, nachdem du das Formular gespeichert hast. Ein neues Feld im Tab „Formular“ hinzugefügt? Speichere das Formular und es erscheint hier."

#: admin/views/panel.php:580 admin/views/panel.php:609
msgid "Translations"
msgstr "Übersetzungen"

#: admin/views/panel.php:582
msgid "Your messages are registered for translation each time you save the form. Save first, then translate them here:"
msgstr "Deine Meldungen werden bei jedem Speichern des Formulars für die Übersetzung registriert. Speichere zuerst und übersetze sie dann hier:"

#: admin/views/panel.php:587
msgid "(opens in a new tab)"
msgstr "(öffnet in neuem Tab)"

#. translators: %s: text domain / string group name.
#: admin/views/panel.php:590
#, php-format
msgid "(look for the group “%s”)"
msgstr "(suche nach der Gruppe „%s“)"

#: admin/views/panel.php:611
msgid "Your messages in the other languages of your site (via the Flavor plugin). A message without a translation is shown in the original language."
msgstr "Deine Meldungen in den anderen Sprachen deiner Website (über das Flavor-Plugin). Eine Meldung ohne Übersetzung wird in der Originalsprache angezeigt."

#: admin/views/panel.php:614
msgid "Languages"
msgstr "Sprachen"

#: admin/views/panel.php:684
msgid "Also show messages that have no original text yet"
msgstr "Auch Meldungen anzeigen, die noch keinen Originaltext haben"

#. translators: %s: language name.
#: admin/views/panel.php:694
#, php-format
msgid "Translate into %s automatically"
msgstr "Automatisch in %s übersetzen"

#: admin/views/panel.php:700
msgid "Automatic translation uses the messages from the last time you saved the form, and replaces what is typed below. Nothing is stored until you save."
msgstr "Die automatische Übersetzung verwendet die Meldungen vom letzten Speichern des Formulars und ersetzt, was unten eingegeben ist. Nichts wird gespeichert, bis du speicherst."

#: admin/views/panel.php:705
msgid "Nothing to translate yet. Write your messages in the fields above and save the form — they will then appear here."
msgstr "Noch nichts zu übersetzen. Schreibe deine Meldungen in die Felder oben und speichere das Formular – sie erscheinen dann hier."

#: admin/views/panel.php:734
msgid "Original:"
msgstr "Original:"

#: admin/views/panel.php:737
msgid "No original message written yet."
msgstr "Noch keine Originalmeldung geschrieben."

#: admin/views/panel.php:761
msgid "Copy, back up and reuse"
msgstr "Kopieren, sichern und wiederverwenden"

#: admin/views/panel.php:762
msgid "move your messages and rules between forms or sites"
msgstr "Meldungen und Regeln zwischen Formularen oder Websites übertragen"

#: admin/views/panel.php:769
msgid "Save this form first. These tools become available once the form exists."
msgstr "Speichere zuerst dieses Formular. Diese Werkzeuge stehen zur Verfügung, sobald das Formular existiert."

#: admin/views/panel.php:772
msgid "These tools work with the last saved version of your forms."
msgstr "Diese Werkzeuge arbeiten mit der zuletzt gespeicherten Version deiner Formulare."

#: admin/views/panel.php:773
msgid "You have unsaved changes on this tab — save the form first if you want them included."
msgstr "Du hast nicht gespeicherte Änderungen in diesem Tab – speichere zuerst das Formular, wenn sie berücksichtigt werden sollen."

#: admin/views/panel.php:780
msgid "Copy from another form"
msgstr "Von einem anderen Formular kopieren"

#: admin/views/panel.php:781
msgid "Take the messages and rules of another form and use them here. Works best when both forms use the same field names."

#. Found in changelog list item.
#, gp-priority: low
msgid "Fixed uninstall script to use correct meta prefix"
msgstr "Исправлен скрипт удаления для использования правильного meta-префикса"

#. Found in changelog list item.
#, gp-priority: low
msgid "Fixed JavaScript prefix inconsistency"
msgstr "Исправлена несогласованность префиксов в JavaScript"

#. Found in changelog list item.
#, gp-priority: low
msgid "Improved accessibility with ARIA labels"
msgstr "Улучшена доступность с помощью ARIA-меток"

#. Found in changelog list item.
#, gp-priority: low
msgid "Added PHPDoc blocks to all functions and methods"
msgstr "Добавлены блоки PHPDoc ко всем функциям и методам"

#. Found in changelog list item.
#, gp-priority: low
msgid "Reorganized file structure for better maintainability"
msgstr "Реорганизована структура файлов для лучшей поддерживаемости"

#. Found in changelog list item.
#, gp-priority: low
msgid "Refactored codebase to follow WordPress Coding Standards"
msgstr "Рефакторинг кодовой базы в соответствии с WordPress Coding Standards"
